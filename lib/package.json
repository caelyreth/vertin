{
  "name": "vertin",
  "type": "module",
  "version": "0.4.0-dev",
  "description": "A universal command line app helper",
  "author": "Kohane <i@kept.to>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/utakotoba/vertin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utakotoba/vertin.git",
    "directory": "packages/vertin"
  },
  "keywords": ["cli", "args"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  }
}
